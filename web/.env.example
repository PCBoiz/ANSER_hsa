# ANSER-HSA — mẫu biến môi trường.
#
# Chép thành `.env.local` rồi điền. KHÔNG điền giá trị thật vào file này —
# `.env.example` là file DUY NHẤT trong nhóm .env được commit, và repo là public.

# ─────────────────────────────────────────────────────────── bắt buộc
# Neon Postgres. Lấy chuỗi "Pooled connection" trong bảng điều khiển Neon.
DATABASE_URL=

# Khoá ký token đăng nhập. Thiếu biến này thì app KHÔNG KHỞI ĐỘNG — có chủ đích,
# xem src/server/auth.ts. Sinh khoá mới, tối thiểu 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mỗi môi trường và mỗi khách hàng một khoá RIÊNG. Dùng chung khoá với hệ thống
# khác nghĩa là token bên đó đăng nhập được vào đây.
JWT_SECRET=

# ────────────────────────────────────── kho file (Cloudflare R2 hoặc Backblaze B2)
# Thiếu nhóm này thì app vẫn chạy, chỉ có đường tải lên/tải về trả 503 kèm
# thông báo nói rõ thiếu biến nào.
#
# R2:  S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# B2:  S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_ENDPOINT=
S3_BUCKET=
# Lấy ở R2 → Overview → Manage API tokens → Create API token.
# Chọn "Object Read & Write" và giới hạn vào ĐÚNG bucket, không cấp toàn tài khoản.
# Secret chỉ hiện một lần.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 bỏ qua region; B2 thì điền đúng region của bucket.
S3_REGION=auto

# ───────────────────────────────────────────────────────── n8n (chưa dùng ở GĐ1)
# Container n8n RIÊNG cho HSA — không dùng chung instance với khách khác:
# credential ngân hàng của bên này và credential Zalo của bên kia không được
# nằm chung một kho.
N8N_WEBHOOK_URL=
N8N_API_URL=
N8N_API_KEY=
N8N_NOTIFY_EMAIL=
