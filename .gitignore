# ---------------------------------------------------------------- bí mật
.env
.env.*
!.env.example

# ------------------------------------------------ tài liệu có tên khách
# Repo public. Mọi thứ nêu đích danh khách, đánh giá vị thế thuế của họ, hay
# logic định giá dịch vụ đều sống ở _khach/ và KHÔNG rời khỏi máy này.
# Một thư mục thay vì một danh sách tên file: thêm tài liệu mới không phải
# nhớ sửa file này — chỗ quên sót duy nhất đã bị bịt.
_khach/

# Lưới thứ hai, phòng khi tài liệu bị đặt nhầm ở gốc repo.
CHIEN_LUOC*.md
*_GUI_KHACH.md
*_DANH_GIA_*.md

# ------------------------------------------------- dữ liệu thật của khách
# Chặn theo đuôi file, kể cả file "đã bôi đen" — bôi đen sót một cột là lộ.
# Dữ liệu mẫu trong sample_data/ được miễn để test chạy được sau khi clone.
*.xlsx
*.xls
*.csv
*.pdf
!sample_data/**/*.xlsx
!sample_data/**/*.csv
du_lieu_khach/
_backups/

# ------------------------------------------------------------ Node / Next
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.vercel

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --------------------------------------------------- script thử một lần
# Tiền tố _ cho mọi script chạy tay lúc kiểm thử. Chúng nói về trạng thái
# một lúc nào đó, không phải về sản phẩm — để lại là rác cho người sau.
_*.mjs
_*.py

