# ════════════════════════════════════════════════════════════════════════════
#  Biến môi trường cho TRIỂN KHAI (docker compose).
#
#  Chép thành `.env` cạnh docker-compose.yml rồi điền. File `.env` bị chặn ở
#  .gitignore và không bao giờ được vào ảnh Docker (xem web/.dockerignore).
#
#  Đây là file cho MÁY CHỦ. Lúc phát triển ở máy cá nhân thì dùng
#  web/.env.local — hai file khác nhau, đừng lẫn.
# ════════════════════════════════════════════════════════════════════════════

# Tên miền Caddy sẽ xin chứng chỉ. Chưa mua tên miền thì dùng subdomain miễn
# phí, ví dụ: anserhsa.duckdns.org
# Muốn thử nhanh bằng IP trần: đặt :80 (HTTP không mã hoá, chỉ để kiểm lúc dựng).
TEN_MIEN=

# Chuỗi kết nối Neon. Lấy ở Dashboard → Connection string (bản có -pooler).
DATABASE_URL=

# Khoá ký phiên đăng nhập. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# KHÔNG dùng lại khoá của máy phát triển.
JWT_SECRET=

# Kho file Cloudflare R2
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
